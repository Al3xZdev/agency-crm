# syntax=docker/dockerfile:1
# Production image shared by the `api` and `worker` compose services (design §10).
# Dev-dependency pruning in the runtime layer is deferred until this image can be
# exercised on a Docker-capable host (Docker absent on the current dev machine).

FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json tsconfig.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY apps/api/package.json apps/api/package.json
RUN pnpm install --frozen-lockfile

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/apps ./apps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json tsconfig.json ./
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api
RUN pnpm --filter @agency-crm/shared build \
 && pnpm --filter @agency-crm/api exec prisma generate \
 && pnpm --filter @agency-crm/api build

FROM base AS runtime
# Non-root runtime (slice-3.5 audit, finding 7). The assets dir is pre-created
# with the app ownership so the named volume inherits it on first mount and
# the local storage driver can write. Dev-dependency pruning stays deferred
# until this image can be exercised on a Docker-capable host.
RUN addgroup -S app && adduser -S app -G app \
 && mkdir -p /app/assets \
 && chown -R app:app /app/assets
ENV NODE_ENV=production
COPY --from=build --chown=app:app /app/node_modules ./node_modules
# Workspace root files needed for `pnpm --filter exec` in migrate commands.
COPY --from=build --chown=app:app /app/pnpm-workspace.yaml /app/package.json /app/pnpm-lock.yaml ./
COPY --from=build --chown=app:app /app/packages/shared ./packages/shared
COPY --from=build --chown=app:app /app/apps/api ./apps/api
USER app
WORKDIR /app/apps/api
EXPOSE 3000
CMD ["node", "dist/main.js"]
