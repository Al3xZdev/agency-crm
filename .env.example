# agency-crm environment template â€” copy to `.env` and fill in real values.
# NEVER commit a real .env.

# --- Postgres (compose service `db`) ---
POSTGRES_USER=agency
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agency_crm
DB_PORT=5432

# --- API ---
# Inside compose network the host is `db`; outside Docker use localhost.
DATABASE_URL=postgresql://agency:change-me@db:5432/agency_crm
API_PORT=3000
# compose sets this for api/worker; document it here so local bare-metal runs
# match container behavior (cookie policy keys off it).
NODE_ENV=production

# --- Sessions / auth ---
SESSION_TTL_DAYS=7

# --- First-run bootstrap (optional) ---
# If both are set, the migrate service creates this SUPER_ADMIN on first boot.
# Leave empty to skip seeding (then no one can log in until a staff row exists).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Absolute web origin baked into client magic-link URLs (task 4.2).
PUBLIC_WEB_URL=http://localhost:3001

# --- Storage (slice 5b) ---
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/app/assets
# S3-compatible storage (slice 12) — used when STORAGE_DRIVER=s3
# For Garage: http://localhost:3900 (default Garage S3 port)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Worker / jobs (slice 6+) ---
WORKER_CONCURRENCY=2

# --- Scheduled jobs kill switches (slice 11b) ---
REMINDERS_DISABLED=false
DIGEST_DISABLED=false

# --- Email (slice 11) ---
SMTP_URL=
MAIL_FROM="Agency CRM <no-reply@example.com>"
# 32-byte random key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAIL_SEAL_KEY=

# --- Web ---
WEB_PORT=3001
# Same-origin proxy target inside compose network:
INTERNAL_API_URL=http://api:3000
