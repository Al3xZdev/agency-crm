# ============================================================
# Agency CRM — environment template
# Copy this file to .env and fill in every variable for the
# services you run. No real secrets are committed here.
# ============================================================

# ------------------------------------------------------------
# PostgreSQL (used by infra/compose.yaml for the db service)
# ------------------------------------------------------------
POSTGRES_USER=                 # default: agency
POSTGRES_PASSWORD=             # REQUIRED — used for the db container
POSTGRES_DB=                   # default: agency_crm
DB_PORT=                       # host port for psql admin access (default: 5432, loopback only)

# ------------------------------------------------------------
# API — database connection and runtime
# ------------------------------------------------------------
DATABASE_URL=                  # REQUIRED — postgresql://user:pass@host:5432/db
NODE_ENV=                      # development | test | production
PORT=                          # API listen port (default: 3000)
SESSION_TTL_DAYS=              # session lifetime in days (default: 7)
PUBLIC_WEB_URL=                # public web origin for links (default: http://localhost:3001)
COOKIE_SECURE=                 # set true to mark auth cookies Secure
API_PORT=                      # host port mapping for the api service (default: 3000)

# ------------------------------------------------------------
# Worker (job queue: version processing, reminders, digests)
# ------------------------------------------------------------
WORKER_CONCURRENCY=            # concurrent jobs per worker (default: 2)
REMINDERS_DISABLED=            # set true to disable approval reminders (default: false)
DIGEST_DISABLED=               # set true to disable the weekly digest (default: false)

# ------------------------------------------------------------
# Web app
# ------------------------------------------------------------
INTERNAL_API_URL=              # API base URL the web app calls (default: http://localhost:3000)
HOSTNAME=                      # bind host for next start (default: 0.0.0.0 in docker)
WEB_STANDALONE=                # set 1 to build Next.js in standalone output mode
WEB_PORT=                      # host port mapping for the web service (default: 3001)

# ------------------------------------------------------------
# Media storage
# ------------------------------------------------------------
STORAGE_DRIVER=                # local | s3 (default: local)
LOCAL_STORAGE_PATH=            # root dir for the local driver (default: /app/assets in docker)

# S3-compatible storage (required when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# ------------------------------------------------------------
# Email (notifications)
# ------------------------------------------------------------
SMTP_URL=                      # smtp(s)://user:pass@host:port — console transport if unset
MAIL_FROM=                     # sender address for outgoing email
MAIL_SEAL_KEY=                 # optional key to encrypt email bodies; unset = pass-through

# ------------------------------------------------------------
# First-run admin bootstrap (migrate service)
# ------------------------------------------------------------
SEED_ADMIN_EMAIL=              # optional — bootstraps a SUPER_ADMIN on first migrate
SEED_ADMIN_PASSWORD=           # optional — paired with SEED_ADMIN_EMAIL